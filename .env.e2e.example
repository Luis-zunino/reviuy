# Entorno EXCLUSIVO de la suite e2e (leído por e2e/scripts/run-e2e-local.mjs y
# playwright.config.ts). Apunta todo el e2e — build de la app incluido — al
# stack local de Supabase (`npx supabase start`), NO a prod: los tests crean
# reseñas, users y sesiones reales contra el destino de NEXT_PUBLIC_SUPABASE_URL.
#
# Copiar a `.env.e2e` (ignorado por git) antes de correr `pnpm test:e2e:local`.
# Las claves son las demo del stack local y salen de `npx supabase status`; si
# tu stack usa otras (p. ej. `supabase start` con otro proyecto), reemplazalas.

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hdp7fsn3W0YpN81IU

# Rate limit deshabilitado en e2e: withRateLimit hace skip si Redis no está
# configurado (src/lib/redis/with-rate-limit.ts). Sin esto, las corridas en
# ráfaga (varios specs crean reseñas) chocan con "Demasiadas reseñas" del
# Upstash de dev y vuelven e2e no determinista.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
